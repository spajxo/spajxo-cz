{% extends 'base.html.twig' %}

{% block title %}Losování | spajxo.cz{% endblock %}

{% block meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block fonts %}
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Nunito:wght@400;600;700&family=Special+Elite&display=swap" rel="stylesheet">
{% endblock %}

{% block html_class %}{% endblock %}
{% block body_class %}theme-vysivky{% endblock %}

{% set input = 'w-full rounded-xl border border-border bg-card px-4 py-2.5 text-base placeholder:text-muted-foreground/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50' %}
{% set label = 'font-typewriter text-sm' %}

{% block body %}
    <main class="mx-auto max-w-2xl px-4 sm:px-6 py-12 space-y-10">
        <header class="text-center space-y-3">
            <img src="{{ asset('images/vercinc-vysivky-logo.webp') }}" alt="Verčinc výšivky" width="128" height="128"
                class="mx-auto {{ result ? 'size-20' : 'size-32' }} rounded-full bg-white p-1 ring-2 ring-wood-light shadow-sm">
            <h1 class="font-typewriter {{ result ? 'text-3xl' : 'text-4xl sm:text-5xl' }}">Losování výherců</h1>
            {% if not result %}<p class="text-muted-foreground">Vyšijeme to poctivě, stejně jako losování 🧵</p>{% endif %}
        </header>

        {% set draw_form %}
        <form method="post" action="{{ path('losovani') }}" id="draw-form" class="{{ result ? 'px-6 pb-6 sm:px-8 sm:pb-8' : 'rounded-3xl bg-card p-6 sm:p-8 shadow-sm' }} space-y-6">
            <div class="space-y-3">
                <label class="block space-y-2">
                    <span class="{{ label }}">Komentáře</span>
                    <textarea name="pasted" rows="6" required placeholder="# 1&#10;@jmeno | text komentáře&#10;↳ @jmeno | odpověď" class="{{ input }} font-mono text-sm">{{ form.pasted ?? '' }}</textarea>
                </label>
                <details class="group rounded-2xl border border-dashed border-wood px-4 py-3 text-sm">
                    <summary class="flex cursor-pointer list-none items-center justify-between font-semibold [&::-webkit-details-marker]:hidden">
                        Jak získat komentáře ze screenshotů
                        <span class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
                    </summary>
                    <ol class="mt-3 list-decimal space-y-1 pl-5 text-muted-foreground">
                        <li>V Instagramu udělej screenshoty všech komentářů pod příspěvkem.</li>
                        <li>Zkopíruj prompt níže a vlož ho do aplikace Claude, přilož screenshoty a odešli.</li>
                        <li>Odpověď (seznam řádků <code>@jméno | text</code>) zkopíruj a vlož do pole Komentáře.</li>
                    </ol>
                    <pre class="mt-3 max-h-48 overflow-auto whitespace-pre-wrap rounded-xl bg-secondary p-3 text-xs" id="prompt">{{ prompt }}</pre>
                    <twig:Button type="button" variant="outline" size="sm" class="mt-3 rounded-full" id="copy-prompt">Zkopírovat prompt</twig:Button>
                </details>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
                <label class="block space-y-2">
                    <span class="{{ label }}">Komentář musí obsahovat</span>
                    <input type="text" name="keyword" value="{{ form.keyword ?? '' }}" placeholder="slovo nebo #hashtag" class="{{ input }}">
                </label>
                <label class="block space-y-2">
                    <span class="{{ label }}">Označit aspoň přátel</span>
                    <input type="number" name="min_mentions" min="0" max="20" value="{{ form.min_mentions ?? 0 }}" class="{{ input }}">
                </label>
                <label class="block space-y-2">
                    <span class="{{ label }}">Počet komentářů na Instagramu</span>
                    <input type="number" name="expected" min="0" inputmode="numeric" value="{{ form.expected ?? '' }}" placeholder="nepovinné" class="{{ input }}">
                    <span class="block text-xs text-muted-foreground">Číslo u bublinky pod příspěvkem. Zkontroluju, že Claude žádný komentář nevynechal.</span>
                </label>
                <label class="block space-y-2">
                    <span class="{{ label }}">Počet výherců</span>
                    <input type="number" name="winners" min="1" max="50" value="{{ form.winners ?? 1 }}" class="{{ input }}">
                </label>
            </div>

            <label class="block space-y-2">
                <span class="{{ label }}">Vyřadit účty</span>
                <input type="text" name="excluded" value="{{ submitted ? form.excluded ?? '' : '@vercinc_vysivky' }}" placeholder="@ucet1, @ucet2" class="{{ input }}">
                <span class="block text-xs text-muted-foreground">Třeba vlastní účet, aby nevyhrály vlastní odpovědi.</span>
            </label>

            <div class="space-y-3">
                <label class="flex items-center gap-3">
                    <input type="checkbox" name="one_per_user" value="1" class="size-4 accent-primary" {{ (submitted ? form.one_per_user is defined : true) ? 'checked' }}>
                    Jeden los na účet <span class="text-sm text-muted-foreground">(platí první komentář)</span>
                </label>
                <label class="flex items-center gap-3">
                    <input type="checkbox" name="include_replies" value="1" class="size-4 accent-primary" {{ form.include_replies is defined ? 'checked' }}>
                    Počítat i odpovědi na komentáře
                </label>
            </div>

            <div class="text-center pt-2">
                <twig:Button type="submit" size="lg" class="rounded-full px-10 text-base">Losovat ♥</twig:Button>
            </div>
        </form>
        {% endset %}
        {% if not result %}{{ draw_form }}{% endif %}

        {% if error %}
            <p class="rounded-2xl border-2 border-dashed border-coral bg-card px-5 py-3 text-center">{{ error }}</p>
        {% endif %}

        {% if result %}
            {% set pasted = result.entries|length %}
            <section class="space-y-10">
                {# Phones: one big hoop for a single winner, two smaller ones per row for several. #}
                {% set several = result.winners|length > 1 %}
                <div class="space-y-6 text-center">
                    <p class="font-typewriter text-2xl">{{ several ? 'A vyhrávají…' : 'A vyhrává…' }}</p>
                    <div class="{{ several ? 'grid grid-cols-2 gap-x-3 gap-y-6 sm:flex sm:flex-wrap sm:justify-center sm:gap-6' : 'flex justify-center' }}" id="winners"
                        data-pool="{{ result.valid|map(c => c.username)|json_encode|e('html_attr') }}">
                        {% for winner in result.winners %}
                            {% set long = winner.username|length > 12 %}
                            <div class="min-w-0 space-y-2 sm:w-60 sm:space-y-3 {{ several ? 'odd:last:col-span-2' : 'w-60' }}" data-winner>
                                <div class="relative mx-auto flex items-center justify-center rounded-full bg-card ring-4 ring-wood-light ring-inset shadow-md {{ several ? 'size-36 border-[7px] p-4 sm:size-56 sm:border-[10px] sm:p-6' : 'size-56 border-[10px] p-6' }} border-wood">
                                    <span class="absolute left-1/2 -translate-x-1/2 rounded-sm bg-wood {{ several ? '-top-3 h-4 w-5 sm:-top-4 sm:h-5 sm:w-6' : '-top-4 h-5 w-6' }}"></span>
                                    <span class="absolute rounded-full border border-dashed border-primary {{ several ? 'inset-3 sm:inset-5' : 'inset-5' }}"></span>
                                    <span class="font-typewriter break-words [overflow-wrap:anywhere] {{ several ? (long ? 'text-xs sm:text-base' : 'text-sm sm:text-xl') : (long ? 'text-base' : 'text-xl') }}" data-name="@{{ winner.username }}">@{{ winner.username }}</span>
                                </div>
                                <p class="line-clamp-3 px-1 text-xs text-muted-foreground sm:text-sm" data-quote>„{{ winner.text }}“</p>
                            </div>
                        {% else %}
                            <p class="text-muted-foreground">Žádný komentář nesplňuje pravidla soutěže.</p>
                        {% endfor %}
                    </div>
                    {# Sticks to the bottom of the screen while there are winners left to reveal. #}
                    <div class="sticky bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 flex justify-center">
                        <twig:Button type="button" size="lg" id="reveal" class="rounded-full px-10 text-base shadow-lg" hidden>Odhalit výherce ♥</twig:Button>
                    </div>
                </div>

                <div class="flex flex-wrap justify-center gap-3">
                    <twig:Button type="submit" form="draw-form" variant="outline" class="rounded-full px-6">↻ Losovat znovu</twig:Button>
                    <twig:Button as="a" href="{{ path('losovani') }}" variant="ghost" class="rounded-full px-6">Nové losování</twig:Button>
                </div>

                {% set criteria = result.criteria %}
                {% set rules = [
                    criteria.keyword ? 'obsahuje „' ~ criteria.keyword ~ '“',
                    criteria.minMentions > 0 ? 'min. ' ~ criteria.minMentions ~ ' označení',
                    criteria.onePerUser ? '1 los na účet' : 'los za každý komentář',
                    criteria.includeReplies ? 'i odpovědi',
                    criteria.excluded ? 'vyřazeno: @' ~ criteria.excluded|join(', @'),
                ]|filter(rule => rule) %}
                <ul class="flex flex-wrap justify-center gap-2 text-sm" aria-label="Pravidla losování">
                    {% for rule in rules %}
                        <li class="rounded-full border border-dashed border-wood bg-card px-3 py-1">{{ rule }}</li>
                    {% endfor %}
                </ul>

                {# Story-highlight style circles. #}
                <div class="flex justify-center gap-5 sm:gap-8">
                    {% for stat in [
                        [result.entries|length, 'komentářů'],
                        [result.participants|length, 'soutěžících'],
                        [result.valid|length, 'losů'],
                    ] %}
                        <div class="text-center space-y-2">
                            <div class="mx-auto flex size-20 items-center justify-center rounded-full border-2 border-primary bg-card p-1">
                                <span class="flex size-full items-center justify-center rounded-full bg-secondary font-typewriter text-2xl">{{ stat[0] }}</span>
                            </div>
                            <p class="text-sm">{{ stat[1] }}</p>
                        </div>
                    {% endfor %}
                </div>

                <p class="text-center text-sm text-muted-foreground">
                    Vylosováno {{ result.drawnAt|date('j. n. Y, H:i:s') }} z {{ pasted }} vložených komentářů.
                </p>

                {# Kept collapsed with a neutral title: the result screen gets filmed, the check is for before or after. #}
                <details class="group rounded-3xl bg-card shadow-sm">
                    <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-4 font-typewriter text-lg [&::-webkit-details-marker]:hidden">
                        Kontrola přepisu
                        <span class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
                    </summary>
                    <div class="space-y-3 px-4 pb-4 sm:px-6 sm:pb-6">
                        {% set matches = result.expected is null or result.expected == pasted %}
                        <div class="rounded-2xl border-2 border-dashed {{ matches ? 'border-primary' : 'border-coral' }} bg-card px-5 py-3 text-sm space-y-2">
                            {% if result.expected is null %}
                                <p>Přepsáno {{ pasted }} komentářů.</p>
                            {% elseif matches %}
                                <p><strong>Sedí ✓</strong> Přepsáno {{ pasted }} z {{ result.expected }} komentářů.</p>
                            {% else %}
                                <p>
                                    <strong>Nesedí:</strong> Instagram ukazuje {{ result.expected }} komentářů, přepsáno {{ pasted }}
                                    ({{ pasted < result.expected ? 'chybí ' ~ (result.expected - pasted) : 'navíc ' ~ (pasted - result.expected) }}).
                                    Instagram do počtu někdy započítá i skryté nebo smazané komentáře.
                                </p>
                            {% endif %}
                            {% if result.post.repeats %}
                                {% set n = result.post.repeats %}
                                <p class="text-xs text-muted-foreground">Vynecháno {{ n }} opakování: stejný komentář (stejný účet a stejná označení) byl na více screenshotech.</p>
                            {% endif %}
                            {% if result.post.screenshots|length > 1 %}
                                <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground" aria-label="Komentáře po screenshotech">
                                    {% for shot in result.post.screenshots %}
                                        <li>screenshot {{ shot.number }}: {{ shot.comments }}{{ shot.overlap ? ' (+' ~ shot.overlap ~ ' už na jiném screenshotu)' }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    {% if result.post.skippedLines %}
                        <div class="rounded-2xl border-2 border-dashed border-coral bg-card px-5 py-3 text-sm space-y-2">
                            <p>{{ result.post.skippedLines|length }} {{ result.post.skippedLines|length == 1 ? 'řádek není' : 'řádků není' }} ve tvaru „@jméno | text“ a do losování se nedostal:</p>
                            <ul class="list-disc pl-5 font-mono text-xs text-muted-foreground">
                                {% for line in result.post.skippedLines|slice(0, 10) %}<li class="break-all">{{ line }}</li>{% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                    {% set uncertain = result.entries|filter(e => e.comment.uncertain)|length %}
                    {% if uncertain %}
                        <p class="rounded-2xl border-2 border-dashed border-wood bg-card px-5 py-3 text-center text-sm">
                            Claude u {{ uncertain }} {{ uncertain == 1 ? 'komentáře' : 'komentářů' }} nebyl jistý přepisem. Jsou označené v seznamu komentářů, zkontroluj je se screenshoty.
                        </p>
                    {% endif %}
                    </div>
                </details>

                <details class="group rounded-3xl bg-card shadow-sm">
                    <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-4 font-typewriter text-lg [&::-webkit-details-marker]:hidden">
                        Upravit pravidla
                        <span class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
                    </summary>
                    {{ draw_form }}
                </details>

                <details class="group rounded-3xl bg-card shadow-sm">
                    <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-4 font-typewriter text-lg [&::-webkit-details-marker]:hidden">
                        Všechny komentáře ({{ result.entries|length }})
                        <span class="text-muted-foreground transition-transform group-open:rotate-180">⌄</span>
                    </summary>
                    <ul class="divide-y divide-dashed divide-border px-4 pb-4 sm:px-6 sm:pb-6">
                        {% for entry in result.entries %}
                            <li class="flex gap-3 py-3 {{ entry.reason ? 'opacity-60' }}">
                                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full text-xs {{ entry.reason ? 'bg-muted' : 'bg-primary text-primary-foreground' }}">{{ entry.reason ? '–' : '✓' }}</span>
                                <div class="min-w-0 flex-1">
                                    <p class="break-words"><strong>@{{ entry.comment.username }}</strong> {{ entry.comment.text }}</p>
                                    <p class="text-xs text-muted-foreground">
                                        {{ entry.comment.screenshot ? 'screenshot ' ~ entry.comment.screenshot ~ ' · ' }}{{ entry.comment.isReply ? 'odpověď · ' }}{{ entry.comment.uncertain ? '⚠ nejistý přepis · ' }}<span class="{{ entry.reason ? 'text-coral' : 'text-primary' }}">{{ entry.reason ?? 'v losování' }}</span>
                                    </p>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </details>
            </section>
        {% endif %}
    </main>

    {# Shown while the form posts. #}
    <div id="drawing" class="fixed inset-0 z-40 flex items-center justify-center bg-background/85 px-6 backdrop-blur-sm" hidden>
        <div class="w-full max-w-sm rounded-3xl bg-card p-8 text-center shadow-lg space-y-5">
            <p class="font-typewriter text-xl" id="drawing-text">Čtu komentáře…</p>
            <div class="h-4 rounded-full border-2 border-dashed border-wood p-0.5">
                <div class="h-full w-0 rounded-full bg-[repeating-linear-gradient(-45deg,var(--color-primary)_0_8px,var(--color-wood-light)_8px_12px)] transition-[width] duration-300" id="drawing-bar"></div>
            </div>
        </div>
    </div>
    <canvas id="confetti" class="pointer-events-none fixed inset-0 z-50 size-full" hidden></canvas>

    <style>
        .is-sealed [data-quote] { visibility: hidden; }
        .is-sealed:not(.is-spinning) [data-name] { font-size: 2.5rem; line-height: 1; }
        .is-spinning [data-name] { filter: blur(0.5px); opacity: 0.75; }
        @keyframes tada { 0% { transform: scale(1); } 30% { transform: scale(0.9) rotate(-4deg); } 55% { transform: scale(1.12) rotate(3deg); } 75% { transform: scale(0.98) rotate(-1deg); } 100% { transform: none; } }
        .is-revealed > div:first-child { animation: tada 700ms ease-out both; }
        @media (prefers-reduced-motion: reduce) { .is-revealed > div:first-child { animation: none; } }
    </style>

    <script>
        (function () {
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            const copy = document.getElementById('copy-prompt');
            copy?.addEventListener('click', async () => {
                const text = document.getElementById('prompt').textContent;
                try {
                    await navigator.clipboard.writeText(text);
                    copy.textContent = 'Zkopírováno ✓';
                } catch (error) {
                    window.getSelection().selectAllChildren(document.getElementById('prompt'));
                    copy.textContent = 'Označeno, zkopíruj ručně';
                }
                setTimeout(() => { copy.textContent = 'Zkopírovat prompt'; }, 2500);
            });

            // Loading overlay with a stitched progress bar that creeps towards 90 % until the page answers.
            const form = document.getElementById('draw-form');
            const overlay = document.getElementById('drawing');
            if (form) {
                form.addEventListener('submit', () => {
                    const bar = document.getElementById('drawing-bar');
                    const text = document.getElementById('drawing-text');
                    const steps = ['Čtu komentáře…', 'Kontroluji pravidla…', 'Míchám losy…'];
                    let progress = 0;
                    overlay.hidden = false;
                    setInterval(() => {
                        progress += (90 - progress) * 0.08;
                        bar.style.width = progress + '%';
                        text.textContent = steps[Math.min(steps.length - 1, Math.floor(progress / 30))];
                    }, 200);
                });
                // Back/forward cache restores the page with the overlay still up.
                window.addEventListener('pageshow', () => { overlay.hidden = true; });
            }

            const container = document.getElementById('winners');
            const button = document.getElementById('reveal');
            const winners = container ? [...container.querySelectorAll('[data-winner]')] : [];
            if (winners.length === 0) {
                return;
            }

            const pool = JSON.parse(container.dataset.pool).map((name) => '@' + name);
            winners.forEach((winner) => {
                winner.classList.add('is-sealed');
                winner.querySelector('[data-name]').textContent = '?';
            });
            button.hidden = false;
            container.parentElement.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });

            const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

            async function spin(name, target) {
                if (reducedMotion || pool.length < 2) {
                    return;
                }
                // Decelerating shuffle, like a wheel slowing down.
                for (let delay = 50; delay < 380; delay *= 1.15) {
                    name.textContent = pool[Math.floor(Math.random() * pool.length)];
                    await sleep(delay);
                }
            }

            function chime() {
                try {
                    const audio = new (window.AudioContext || window.webkitAudioContext)();
                    [523.25, 659.25, 783.99, 1046.5].forEach((frequency, i) => {
                        const oscillator = audio.createOscillator();
                        const gain = audio.createGain();
                        const start = audio.currentTime + i * 0.11;
                        oscillator.type = 'triangle';
                        oscillator.frequency.value = frequency;
                        gain.gain.setValueAtTime(0.0001, start);
                        gain.gain.exponentialRampToValueAtTime(0.18, start + 0.02);
                        gain.gain.exponentialRampToValueAtTime(0.0001, start + (i === 3 ? 0.9 : 0.25));
                        oscillator.connect(gain).connect(audio.destination);
                        oscillator.start(start);
                        oscillator.stop(start + 1);
                    });
                } catch (error) {
                    // Sound is a bonus; ignore browsers that refuse it.
                }
            }

            function confetti(origin) {
                if (reducedMotion) {
                    return;
                }
                const canvas = document.getElementById('confetti');
                const context = canvas.getContext('2d');
                const ratio = window.devicePixelRatio || 1;
                canvas.width = innerWidth * ratio;
                canvas.height = innerHeight * ratio;
                context.scale(ratio, ratio);
                canvas.hidden = false;

                const style = getComputedStyle(document.body);
                const colors = ['--color-coral', '--color-primary', '--color-wood', '--color-wood-light'].map((name) => style.getPropertyValue(name).trim());
                colors.push('#d9a593');
                const pieces = Array.from({ length: 90 }, () => ({
                    x: origin.x, y: origin.y,
                    vx: (Math.random() - 0.5) * 14, vy: -Math.random() * 13 - 4,
                    size: 6 + Math.random() * 8, spin: Math.random() * 6, turn: (Math.random() - 0.5) * 0.3,
                    shape: Math.random() < 0.4 ? 'heart' : Math.random() < 0.5 ? 'leaf' : 'dot',
                    color: colors[Math.floor(Math.random() * colors.length)],
                }));

                const draw = (piece) => {
                    context.save();
                    context.translate(piece.x, piece.y);
                    context.rotate(piece.spin);
                    context.fillStyle = piece.color;
                    const s = piece.size;
                    context.beginPath();
                    if (piece.shape === 'heart') {
                        context.moveTo(0, s * 0.3);
                        context.bezierCurveTo(-s, -s * 0.4, -s * 0.4, -s, 0, -s * 0.45);
                        context.bezierCurveTo(s * 0.4, -s, s, -s * 0.4, 0, s * 0.3);
                    } else if (piece.shape === 'leaf') {
                        context.ellipse(0, 0, s * 0.25, s * 0.6, 0, 0, Math.PI * 2);
                    } else {
                        context.arc(0, 0, s * 0.3, 0, Math.PI * 2);
                    }
                    context.fill();
                    context.restore();
                };

                const started = performance.now();
                (function frame(now) {
                    context.clearRect(0, 0, innerWidth, innerHeight);
                    pieces.forEach((piece) => {
                        piece.vy += 0.35;
                        piece.vx *= 0.99;
                        piece.x += piece.vx;
                        piece.y += piece.vy;
                        piece.spin += piece.turn;
                        draw(piece);
                    });
                    if (now - started < 3000) {
                        requestAnimationFrame(frame);
                    } else {
                        canvas.hidden = true;
                    }
                })(started);
            }

            button.addEventListener('click', async () => {
                const winner = winners.find((item) => item.classList.contains('is-sealed'));
                if (!winner || button.disabled) {
                    return;
                }
                button.disabled = true;
                winner.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
                const name = winner.querySelector('[data-name]');
                winner.classList.add('is-spinning');
                await spin(name);
                winner.classList.remove('is-spinning', 'is-sealed');
                name.textContent = name.dataset.name;
                winner.classList.add('is-revealed');
                const hoop = winner.firstElementChild.getBoundingClientRect();
                confetti({ x: hoop.left + hoop.width / 2, y: hoop.top + hoop.height / 2 });
                chime();

                const remaining = winners.filter((item) => item.classList.contains('is-sealed')).length;
                button.disabled = false;
                button.hidden = remaining === 0;
                button.textContent = 'Odhalit dalšího výherce ♥';
            });
        })();
    </script>
{% endblock %}
