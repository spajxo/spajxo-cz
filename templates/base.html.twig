<!DOCTYPE html>
<html lang="cs" class="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}spajxo.cz{% endblock %}</title>
        {% set description = 'Pavel Stejskal, systémový architekt v Digital Solutions. Modernizace enterprise systémů, event-driven architektura, observabilita a AI ve vývoji.' %}
        <meta name="description" content="{{ description }}">
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
        <meta property="og:type" content="website">
        <meta property="og:locale" content="cs_CZ">
        <meta property="og:site_name" content="spajxo.cz">
        <meta property="og:title" content="{{ block('title')|trim }}">
        <meta property="og:description" content="{{ description }}">
        <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
        <meta property="og:image" content="https://github.com/spajxo.png?s=400">
        {% if revision %}<meta name="revision" content="{{ revision }}">{% endif %}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>S</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen">
        {% block body %}{% endblock %}
    </body>
</html>
